{
  "manifest_version": 3,
  "name": "Tab Eviction Court",
  "version": "1.0",
  "description": "Puts closed tabs on trial before a retro AI judge.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "courtroom.html",
        "courtroom.css",
        "courtroom.js",
        "assets/*",
        "Press_Start_2P/*",
        "VT323/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}